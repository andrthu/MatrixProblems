prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
CXX=/usr/bin/c++ 
CC=/usr/bin/cc
DEPENDENCIES=

Name: MatrixProblems
Version: 1
Description: MatrixProblems module
URL: http://dune-project.org/
Requires: dune-common dune-istl dune-geometry dune-grid
Libs: -L${libdir}
Cflags: -I${includedir}
